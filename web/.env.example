# API base URL the SPA calls. Default "/api" (same-origin behind Traefik or via
# the Vite dev proxy). Set for a cross-origin API host, e.g.:
# VITE_API_BASE=https://uccc-api.example.org/api

# Dev-only: where the Vite proxy forwards /api during `npm run dev`.
# VITE_API_TARGET=http://localhost:8000
