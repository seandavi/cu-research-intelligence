# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# All variables are read by src/cu_openalex/config.py (prefix CU_OPENALEX_).

# --- OpenAlex API (author discovery) ---
# Your OpenAlex API key (authenticates to the polite pool; free tier).
CU_OPENALEX_API_KEY=
# Contact email for the OpenAlex polite pool (required by their etiquette).
CU_OPENALEX_MAILTO=seandavi@gmail.com

# --- Target ---
# OpenAlex institution id for University of Colorado Anschutz Medical Campus.
CU_OPENALEX_INSTITUTION_ID=I51713134
# Keep authors with a CU-Anschutz affiliation year >= (current_year - YEAR_WINDOW).
CU_OPENALEX_YEAR_WINDOW=7

# --- Orchestration (Prefect) ---
# Flows default to a local ephemeral Prefect backend, ignoring any Prefect Cloud
# URL in your profile. Set to 1 to use your configured Prefect API instead.
# CU_OPENALEX_USE_PREFECT_API=0

# --- Storage landing pad ---
# Where Parquet + DuckDB state live. Local today; swap to R2 later with no code change.
#   local : file://./data
#   R2    : s3://my-bucket/openalex
CU_OPENALEX_STORAGE_BASE_URI=file://./data

# --- Cloudflare R2 (only needed when STORAGE_BASE_URI is s3://) ---
# R2 is S3-compatible. Provide an account-scoped endpoint + access keys.
# CU_OPENALEX_R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# CU_OPENALEX_R2_ACCESS_KEY_ID=
# CU_OPENALEX_R2_SECRET_ACCESS_KEY=
# CU_OPENALEX_R2_REGION=auto

# --- cdsci-lake (shared DuckLake substrate; ADR-0022/0023) ---
# The offline build/grants steps source canonical facts (iCite RCR + DOI->PMID,
# NIH RePORTER) from the shared lake via the `cdsci.lake` accessor instead of
# per-project APIs. These vars are read by `cdsci.lake` (same CU_OPENALEX_ .env).
#   local    -> single-file DuckLake catalog under ./data (dev/test)
#   postgres -> the full shared store: Postgres catalog + R2 data; secrets from
#               Google Secret Manager via `gcloud` (run `gcloud auth login` first).
CU_OPENALEX_LAKE_BACKEND=postgres
# Postgres-catalog defaults live in cdsci.lake (host 100.74.53.55, db `lake`, GSM
# project cdsci-infra). Override here only if your deployment differs, e.g.:
# CU_OPENALEX_LAKE_PG_HOST=100.74.53.55
# CU_OPENALEX_GSM_PROJECT=cdsci-infra

# --- Serving / chat (docker-compose deployment; see docs/DEPLOYMENT.md) ---
# Server-side Gemini key that enables the /api/chat NL->SQL endpoint. End users
# never supply it. Leave unset to run with chat disabled (every other endpoint
# still works). Read by the API process, not via the CU_OPENALEX_ Settings.
GEMINI_API_KEY=
# Optional chat model override. Leave blank to use the default (gemini-2.5-flash).
CU_OPENALEX_CHAT_MODEL=
# Comma-separated browser origins allowed to call the API (CORS). Default '*'.
# Not needed for the bundled docker-compose deploy (the SPA and API share one
# origin); set it only when a separately-hosted frontend calls the API directly.
# CU_OPENALEX_CORS_ORIGINS=*
